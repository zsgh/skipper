# ── Temporal ──────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=skipper-task-queue
TEMPORAL_UI_BASE=http://localhost:8233

# ── berth（沙箱执行服务）──────────────────────────────────
BERTH_BASE_URL=http://localhost:9000

# ── LLM（OpenAI 兼容接口，任何一个都行）───────────────────
# 例：OpenAI 官方
#   SKIPPER_LLM_BASE_URL=https://api.openai.com/v1
#   SKIPPER_LLM_API_KEY=sk-...
#   SKIPPER_LLM_MODEL=gpt-4o-mini
# 不设置时回退到 OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL
SKIPPER_LLM_BASE_URL=
SKIPPER_LLM_API_KEY=
SKIPPER_LLM_MODEL=

# ── Driver ───────────────────────────────────────────────
SKIPPER_DEFAULT_DRIVER=self_loop
SKIPPER_SELF_LOOP_MAX_TURNS=20
SKIPPER_OPENCODE_IMAGE=opencode
SKIPPER_OPENCODE_PROVIDER_ID=skipper
# opencode(Bun) 比普通脚本吃内存；berth 默认 256MB 会把它 SIGTERM
SKIPPER_OPENCODE_MEMORY_MB=1024
SKIPPER_OPENCODE_CPU_PERCENT=200

# ── 可观测性（Phoenix）───────────────────────────────────
SKIPPER_TRACING=1
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=skipper
